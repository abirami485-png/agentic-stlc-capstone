{
  "name": "agentic-stlc-capstone",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready Playwright TypeScript automation framework for SauceDemo.",
  "scripts": {
    "test": "playwright test",
    "test:list": "playwright test --list",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "build": "tsc --noEmit",
    "install:browsers": "playwright install --with-deps"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.7",
    "playwright": "^1.49.1",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
